<Window x:Class="GigaGlade.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GigaGlade"
        Title="GigaGlade">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Padding="8" RowSpacing="6" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The treemap is worth more than a wide tree: fixed, narrow tree column. -->
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2">
            <ComboBox x:Name="DriveBox" AutomationProperties.AutomationId="DriveBox" AutomationProperties.Name="Drive" MinWidth="220" SelectionChanged="DriveBox_SelectionChanged" />
            <Button x:Name="RescanButton" AutomationProperties.AutomationId="RescanButton" Content="Rescan" Click="Rescan_Click" />
            <ToggleButton x:Name="FreeToggle" AutomationProperties.AutomationId="FreeToggle" Content="Free space" IsChecked="True" Click="FreeToggle_Click"
                          ToolTipService.ToolTip="Show free disk space, idle CPU or available memory in the treemap" />
            <Button x:Name="ZoomButton" AutomationProperties.AutomationId="ZoomButton" Content="Zoom to selection" Click="Zoom_Click" />
            <Button x:Name="ExplorerButton" AutomationProperties.AutomationId="ExplorerButton" Content="Show in Explorer" Click="Explorer_Click" />
            <Button x:Name="CopyButton" AutomationProperties.AutomationId="CopyButton" Content="Copy path" Click="Copy_Click" />
            <Button x:Name="RecycleButton" AutomationProperties.AutomationId="RecycleButton" Content="Recycle…" Click="Recycle_Click" />
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteButton" Content="Delete permanently…" Click="Delete_Click" />
        </StackPanel>

        <ListView x:Name="Tree" Grid.Row="1" AutomationProperties.AutomationId="Tree" AutomationProperties.Name="Folders and files"
                  SelectionMode="Single" SelectionChanged="Tree_SelectionChanged" PreviewKeyDown="Tree_KeyDown"
                  DoubleTapped="Tree_DoubleTapped" ItemsSource="{x:Bind Rows}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TreeRow">
                    <Grid ColumnSpacing="6" AutomationProperties.Name="{x:Bind Label}" Background="Transparent"
                          PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Border Background="Transparent" Padding="{x:Bind Indent}" Tapped="Chevron_Tapped">
                            <FontIcon Glyph="{x:Bind Chevron}" FontSize="10" Width="16" Height="24" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{x:Bind Percent}" Maximum="100" VerticalAlignment="Center" MinWidth="0" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Views" SelectionChanged="Views_SelectionChanged" AutomationProperties.AutomationId="Views">
                <SelectorBarItem Text="Treemap" AutomationProperties.AutomationId="ViewTreemap" IsSelected="True" />
                <SelectorBarItem Text="File types" AutomationProperties.AutomationId="ViewFileTypes" />
                <SelectorBarItem Text="Largest" AutomationProperties.AutomationId="ViewLargest" />
                <SelectorBarItem Text="Oldest" AutomationProperties.AutomationId="ViewOldest" />
                <SelectorBarItem Text="Space hogs" AutomationProperties.AutomationId="ViewSpaceHogs" />
                <SelectorBarItem Text="Duplicates" AutomationProperties.AutomationId="ViewDuplicates" />
            </SelectorBar>
            <!-- Views, breadcrumb and filter share one line. -->
            <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="Crumbs_ItemClicked" AutomationProperties.AutomationId="Crumbs" />
            <TextBox x:Name="FilterBox" Grid.Column="2" Width="200" VerticalAlignment="Center" PlaceholderText="Filter, e.g. *.iso" Visibility="Collapsed"
                         AutomationProperties.Name="Filter" AutomationProperties.AutomationId="FilterBox" TextChanged="Filter_TextChanged" />
            <Grid x:Name="MapHost" Grid.Row="1" Grid.ColumnSpan="3" Background="Transparent" SizeChanged="MapHost_SizeChanged"
                  PointerPressed="Map_PointerPressed" PointerMoved="Map_PointerMoved" PointerExited="Map_PointerExited" DoubleTapped="Map_DoubleTapped"
                  AutomationProperties.AutomationId="MapHost" AutomationProperties.Name="Treemap">
                <Image x:Name="MapImage" Stretch="Fill" AutomationProperties.AutomationId="MapImage" AutomationProperties.Name="Treemap" />
                <Canvas x:Name="MapOverlay" IsHitTestVisible="False">
                    <Rectangle x:Name="MapSelection" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="3" Visibility="Collapsed" />
                    <TextBlock x:Name="FreeLabel" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                    <Rectangle x:Name="MapHover" Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                               StrokeThickness="2" StrokeDashArray="3,2" Visibility="Collapsed" />
                </Canvas>
            </Grid>
            <ListView x:Name="ResultList" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="ResultList_SelectionChanged"
                      AutomationProperties.AutomationId="ResultList" AutomationProperties.Name="Results">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ResultRow">
                        <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="12" Height="12" Fill="{x:Bind Brush}" />
                            <StackPanel Grid.Column="1" Padding="0,4">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Size}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Compact: one line, grows (up to a limit) only when there is something to preview. -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3" Padding="8,4" CornerRadius="6" MaxHeight="230" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewTitle" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PreviewTitle" />
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" MaxHeight="200" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Preview" />
                <MediaPlayerElement x:Name="PreviewMedia" Grid.Row="1" Height="200" AreTransportControlsEnabled="True" Visibility="Collapsed" AutoPlay="False" />
                <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" MaxHeight="200" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="PreviewText" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Width="200" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
