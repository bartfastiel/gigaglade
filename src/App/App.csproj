<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GigaGlade</RootNamespace>
    <AssemblyName>GigaGlade</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Portable: one folder with everything in it, no installer, no package identity. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- -p:Elevated=false builds a variant without administrator rights for UI tests. -->
    <Elevated Condition="'$(Elevated)' == ''">true</Elevated>
    <ApplicationManifest Condition="'$(Elevated)' == 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Elevated)' != 'true'">app.test.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Publishing an unpackaged app leaves out its own resource index and compiled XAML; without them it cannot start. -->
  <Target Name="PublishAppResources" AfterTargets="Publish">
    <ItemGroup>
      <AppResource Include="$(OutDir)$(AssemblyName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(AppResource)" DestinationFolder="$(PublishDir)" />
  </Target>
  <ItemGroup>
    <!-- The index consists of large arrays; give their memory back when it is replaced. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>
</Project>
